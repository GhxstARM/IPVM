FROM node:20-alpine

WORKDIR /app

# Copiar package.json y package-lock.json primero (optimiza el caché de Docker)
COPY package*.json ./

# Instalar dependencias
RUN npm install

# Copiar el resto del código
COPY . .

EXPOSE 3000

# Asumiendo que usas nodemon (que vi en tu tree) o node directamente
CMD ["npm", "run", "dev"] 
# (Si tu package.json no tiene "dev", cámbialo por CMD ["node", "app.js"])